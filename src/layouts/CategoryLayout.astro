---
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

interface Props {
  title: string;
  description: string;
  collection: string;
  posts: any[];
}

const { title, description, collection, posts } = Astro.props;
---
<BaseLayout title={`${title} — Mein Meera`} description={description}>
  <div class="category-hero">
    <span class="category-hero__eyebrow">Category</span>
    <h1 class="category-hero__title">{title}</h1>
    <p class="category-hero__description">{description}</p>
  </div>

  <div class="container category-grid">
    <div class="post-grid">
      {posts.map(post => (
        <PostCard post={{...post, collection}} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .category-grid {
    padding-bottom: var(--space-section);
  }
</style>
