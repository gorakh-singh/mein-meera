---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="404 Error">
  <div class="container not-found">
    <h1>Oh, hello there!</h1>
    <p>It seems you've wandered off the map. The page you're looking for isn't here.</p>
    <p>Try using the search function, or head back to the <a href="/">homepage</a>.</p>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding: var(--space-4xl) 0;
    text-align: center;
    max-width: 60ch;
    margin: 0 auto;
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--step-5);
    margin-bottom: var(--space-md);
  }
  p {
    font-size: var(--step-1);
    margin-bottom: var(--space-md);
  }
  a {
    color: var(--color-terracotta);
  }
</style>
