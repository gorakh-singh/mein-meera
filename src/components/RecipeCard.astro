---
export interface Props {
  recipe: {
    id: string;
    data: {
      title: string;
      description: string;
      heroUrl: string;
      cookTime?: string;
      difficulty?: string;
      [key: string]: unknown;
    };
  };
}

const { recipe } = Astro.props;
const { title, description, heroUrl, cookTime, difficulty } = recipe.data;
const slug = recipe.id;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a href={`${base}/recipes/${slug}/`} class="recipe-card">
  <div class="image-wrapper">
    <img src={heroUrl} alt="" loading="lazy" />
  </div>
  <div class="content">
    <span class="eyebrow">Recipe</span>
    <h3 class="title">{title}</h3>
    <p class="desc">{description}</p>
    {(cookTime || difficulty) && (
      <div class="meta">
        {cookTime && <span>{cookTime}</span>}
        {cookTime && difficulty && <span class="dot">·</span>}
        {difficulty && <span>{difficulty}</span>}
      </div>
    )}
  </div>
</a>

<style>
  .recipe-card {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
    min-width: 280px;
    scroll-snap-align: start;
  }
  .recipe-card:focus-visible {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 4px;
    border-radius: var(--border-radius);
  }
  .image-wrapper {
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: var(--border-radius);
    margin-bottom: var(--space-md);
  }
  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-gentle);
  }
  .recipe-card:hover .image-wrapper img {
    transform: scale(1.03);
  }
  .eyebrow {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-green);
    margin-bottom: var(--space-xs);
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs);
    line-height: 1.3;
  }
  .desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-sm);
    line-height: 1.5;
  }
  .meta {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    display: flex;
    gap: var(--space-xs);
  }
  .dot { opacity: 0.5; }

  @media (prefers-reduced-motion: reduce) {
    .image-wrapper img { transition: none; }
    .recipe-card:hover .image-wrapper img { transform: none; }
  }
</style>
