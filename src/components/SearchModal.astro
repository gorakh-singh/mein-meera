---
---
<div id="search-modal" class="search-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Search site">
  <div class="search-overlay" id="search-overlay"></div>
  
  <div class="search-content">
    <button class="search-close" id="search-close" aria-label="Close search">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    
    <div id="pagefind-search"></div>
  </div>
</div>

<link href="/_pagefind/pagefind-ui.css" rel="stylesheet">
<script is:inline src="/_pagefind/pagefind-ui.js" defer></script>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }
  .search-modal:not([aria-hidden="true"]) {
    display: flex;
  }
  .search-overlay {
    position: absolute;
    inset: 0;
    background: rgba(26, 26, 26, 0.8);
    backdrop-filter: blur(2px);
  }
  .search-content {
    position: relative;
    z-index: 2001;
    background: var(--color-cream);
    width: 100%;
    max-width: 600px;
    padding: var(--space-xl);
    border-radius: var(--border-radius);
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }
  .search-close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    background: none;
    border: none;
    color: var(--color-ink);
    cursor: pointer;
  }
  .search-close:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 2px;
  }
</style>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    if(window.PagefindUI) {
      new window.PagefindUI({ element: "#pagefind-search", showSubResults: true });
    }
    
    const modal = document.getElementById('search-modal');
    const closeBtn = document.getElementById('search-close');
    const overlay = document.getElementById('search-overlay');
    
    function closeSearch() {
      if(modal) modal.setAttribute('aria-hidden', 'true');
    }
    
    closeBtn?.addEventListener('click', closeSearch);
    overlay?.addEventListener('click', closeSearch);
    
    document.addEventListener('keydown', (e) => {
      if (modal?.getAttribute('aria-hidden') === 'false' && e.key === 'Escape') {
        closeSearch();
      }
    });
  });
</script>
