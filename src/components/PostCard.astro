---
import FormattedDate from './FormattedDate.astro';

export interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      heroUrl: string;
      date: Date;
      tags?: string[];
      place?: string;
      tripDate?: string;
      [key: string]: unknown;
    };
    collection: string;
  };
}

const { post } = Astro.props;
const { title, description, heroUrl, date } = post.data;
const slug = post.id;
const collection = post.collection;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a href={`${base}/${collection}/${slug}/`} class="post-card">
  <div class="image-wrapper">
    <img src={heroUrl} alt="" loading="lazy" />
  </div>
  <div class="content">
    <span class="eyebrow">{collection}</span>
    <h3 class="title">{title}</h3>
    <p class="desc">{description}</p>
    <FormattedDate date={date} />
  </div>
</a>

<style>
  .post-card {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
  }
  .post-card:focus-visible {
    outline: 2px solid var(--color-terracotta);
    outline-offset: 4px;
    border-radius: var(--border-radius);
  }
  .image-wrapper {
    aspect-ratio: 3/2;
    overflow: hidden;
    border-radius: var(--border-radius);
    margin-bottom: var(--space-md);
  }
  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-gentle);
  }
  .post-card:hover .image-wrapper img {
    transform: scale(1.03);
  }
  .eyebrow {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-green);
    margin-bottom: var(--space-xs);
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 400;
    color: var(--color-ink);
    margin: 0 0 var(--space-xs);
    line-height: 1.3;
  }
  .desc {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-sm);
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .image-wrapper img { transition: none; }
    .post-card:hover .image-wrapper img { transform: none; }
  }
</style>
